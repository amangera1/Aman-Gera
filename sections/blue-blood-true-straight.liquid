{{ 'blue-blood-common.css' | asset_url | stylesheet_tag }}
{{ 'blue-blood-true-straight.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .bb-true-straight {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --bb-bg: {{ section.settings.background_color }};
    --bb-accent: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .bb-true-straight__showcase {
    gap: {{ section.settings.showcase_gap }}px;
  }

  #shopify-section-{{ section.id }} .bb-true-straight__loom-section {
    margin-top: {{ section.settings.loom_section_margin_top }}px;
  }

  {% if section.settings.denim_texture != blank %}
    #shopify-section-{{ section.id }} .bb-true-straight__selvedge-box {
      background-image: url('{{ section.settings.denim_texture | image_url: width: 1200 }}');
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .bb-true-straight {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
</style>

<section class="bb-section bb-true-straight" id="bb-true-straight-{{ section.id }}">
  <div class="bb-paper-texture"></div>

  <div class="bb-inner">
    {% if section.settings.show_nav %}
      <nav class="bb-true-straight__nav bb-caps" aria-label="Product styles">
        {% if section.settings.nav_link_1_label != blank %}
          <a href="{{ section.settings.nav_link_1_url | default: '#' }}" {% if section.settings.nav_active == '1' %}class="is-active"{% endif %}>
            {{ section.settings.nav_link_1_label }}
          </a>
        {% endif %}
        {% if section.settings.nav_link_2_label != blank %}
          <a href="{{ section.settings.nav_link_2_url | default: '#' }}" {% if section.settings.nav_active == '2' %}class="is-active"{% endif %}>
            {{ section.settings.nav_link_2_label }}
          </a>
        {% endif %}
        {% if section.settings.nav_link_3_label != blank %}
          <a href="{{ section.settings.nav_link_3_url | default: '#' }}" {% if section.settings.nav_active == '3' %}class="is-active"{% endif %}>
            {{ section.settings.nav_link_3_label }}
          </a>
        {% endif %}
      </nav>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="bb-true-straight__title bb-brush">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="bb-true-straight__showcase">
      <div class="bb-true-straight__product-wrap">
        {% if section.settings.product_image != blank %}
          {{
            section.settings.product_image
            | image_url: width: 1000
            | image_tag: loading: 'eager', alt: section.settings.title
          }}
        {% endif %}

        {% if section.settings.callout_1 != blank %}
          <div class="bb-callout bb-true-straight__callout--fit">
            <span class="bb-callout__text">{{ section.settings.callout_1 }}</span>
            <svg class="bb-callout__arrow" viewBox="0 0 50 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 15 C15 5, 30 25, 48 10" stroke="currentColor" stroke-width="2" fill="none"/>
              <path d="M42 6 L48 10 L44 16" stroke="currentColor" stroke-width="2" fill="none"/>
            </svg>
          </div>
        {% endif %}

        {% if section.settings.callout_2 != blank %}
          <div class="bb-callout bb-true-straight__callout--rise">
            <span class="bb-callout__text">{{ section.settings.callout_2 }}</span>
            <svg class="bb-callout__arrow" viewBox="0 0 50 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 20 C15 10, 30 5, 48 18" stroke="currentColor" stroke-width="2" fill="none"/>
              <path d="M42 14 L48 18 L44 24" stroke="currentColor" stroke-width="2" fill="none"/>
            </svg>
          </div>
        {% endif %}
      </div>

      <div class="bb-true-straight__content">
        {% if section.settings.intro_text != blank %}
          <div class="bb-true-straight__intro">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="bb-btn">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.detail_image != blank %}
        <div class="bb-true-straight__detail-img">
          {{
            section.settings.detail_image
            | image_url: width: 500
            | image_tag: loading: 'lazy', alt: 'Product detail'
          }}
        </div>
      {% endif %}
    </div>

    <div class="bb-true-straight__loom-section">
      {% if section.settings.loom_heading != blank %}
        <p class="bb-true-straight__loom-heading bb-brush">{{ section.settings.loom_heading }}</p>
        <svg class="bb-true-straight__loom-arrow" viewBox="0 0 120 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M5 10 C40 50, 80 5, 115 45" stroke="currentColor" stroke-width="2.5" fill="none"/>
          <path d="M108 38 L115 45 L106 50" stroke="currentColor" stroke-width="2.5" fill="none"/>
        </svg>
      {% endif %}

      <div class="bb-true-straight__selvedge-wrap">
        <div class="bb-true-straight__selvedge-box">
          {% if section.settings.selvedge_heading != blank %}
            <h3 class="bb-caps">{{ section.settings.selvedge_heading }}</h3>
          {% endif %}

          {% if section.settings.selvedge_points != blank %}
            <ul>
              {% assign points = section.settings.selvedge_points | split: '|' %}
              {% for point in points %}
                <li>{{ point | strip }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if section.settings.selvedge_footer != blank %}
            <p class="bb-true-straight__selvedge-footer bb-caps">{{ section.settings.selvedge_footer }}</p>
          {% endif %}

          {% if section.settings.selvedge_tag != blank %}
            <div class="bb-true-straight__selvedge-tag">
              <div class="bb-brush-stroke">
                <span>{{ section.settings.selvedge_tag }}</span>
              </div>
            </div>
          {% endif %}
        </div>

        {% if section.settings.loom_image != blank %}
          <div class="bb-true-straight__loom-img">
            {{
              section.settings.loom_image
              | image_url: width: 1100
              | image_tag: loading: 'lazy', alt: 'Shuttle loom illustration'
            }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blue Blood True Straight",
  "tag": "section",
  "class": "section-blue-blood-true-straight",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#e5e0d8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#a33b20"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show navigation links",
      "default": true
    },
    {
      "type": "text",
      "id": "nav_link_1_label",
      "label": "Nav link 1 label",
      "default": "5 POCKET SLIM STRAIGHT"
    },
    {
      "type": "url",
      "id": "nav_link_1_url",
      "label": "Nav link 1 URL"
    },
    {
      "type": "text",
      "id": "nav_link_2_label",
      "label": "Nav link 2 label",
      "default": "5 POCKET TRUE STRAIGHT"
    },
    {
      "type": "url",
      "id": "nav_link_2_url",
      "label": "Nav link 2 URL"
    },
    {
      "type": "text",
      "id": "nav_link_3_label",
      "label": "Nav link 3 label",
      "default": "DOUBLE KNEE CARPENTER"
    },
    {
      "type": "url",
      "id": "nav_link_3_url",
      "label": "Nav link 3 URL"
    },
    {
      "type": "select",
      "id": "nav_active",
      "label": "Active nav item",
      "options": [
        { "value": "1", "label": "Link 1" },
        { "value": "2", "label": "Link 2" },
        { "value": "3", "label": "Link 3" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Product showcase"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "BLUE BLOOD 2.0 TRUE STRAIGHT"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "callout_1",
      "label": "Callout 1",
      "default": "STRAIGHT FIT"
    },
    {
      "type": "text",
      "id": "callout_2",
      "label": "Callout 2",
      "default": "MID-RISE"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p><strong>Born in the late 1800s,</strong> the 5-pocket jean was built for miners who needed something tougher than anything else they owned.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Pocket detail image"
    },
    {
      "type": "header",
      "content": "Selvedge section"
    },
    {
      "type": "text",
      "id": "loom_heading",
      "label": "Loom heading",
      "default": "BUILT ON VINTAGE TRADITIONAL SHUTTLE LOOMS"
    },
    {
      "type": "image_picker",
      "id": "loom_image",
      "label": "Loom illustration image"
    },
    {
      "type": "image_picker",
      "id": "denim_texture",
      "label": "Denim texture background"
    },
    {
      "type": "text",
      "id": "selvedge_heading",
      "label": "Selvedge box heading",
      "default": "WHAT MAKES SELVEDGE DIFFERENT?"
    },
    {
      "type": "textarea",
      "id": "selvedge_points",
      "label": "Selvedge bullet points (separate with |)",
      "default": "Shuttle Loom Woven|Slower process. Stronger fabric. No shortcuts.|Self-Finished Edges. No fraying. No weak points. Just a clean, durable finish.|15oz Weight. Heavier denim that holds structure and lasts longer.|Built for Patina. Every crease, fade, and mark is earned over time."
    },
    {
      "type": "text",
      "id": "selvedge_footer",
      "label": "Selvedge footer text",
      "default": "THIS ISN'T DENIM THAT STAYS THE SAME."
    },
    {
      "type": "text",
      "id": "selvedge_tag",
      "label": "Selvedge tag text",
      "default": "IT'S DENIM THAT BECOMES YOURS."
    },
    {
      "type": "header",
      "content": "Spacing — Desktop"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Section margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Section margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Section padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Section padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "showcase_gap",
      "label": "Showcase column gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "loom_section_margin_top",
      "label": "Loom section margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Spacing — Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Section margin top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Section margin bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Blue Blood True Straight"
    }
  ]
}
{% endschema %}
