{{ 'section9-slim-straight.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .lp-section9 {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    --lp9-bg: {{ section.settings.background_color }};
    --lp9-accent: {{ section.settings.accent_color }};
    --lp9-max-width: {{ section.settings.max_width }}px;
    --lp9-min-height: {{ section.settings.min_height }}px;
    --lp9-padding-top: {{ section.settings.padding_top }}px;
    --lp9-padding-bottom: {{ section.settings.padding_bottom }}px;
    --lp9-column-gap: {{ section.settings.column_gap }}px;
    --lp9-left-width: {{ section.settings.left_width }}%;
    --lp9-circle-color: {{ section.settings.circle_color }};
    --lp9-circle-size: {{ section.settings.circle_size }}px;
    --lp9-circle-top: {{ section.settings.circle_top }}%;
    --lp9-circle-left: {{ section.settings.circle_left }}%;
    --lp9-bg-fit: {{ section.settings.bg_fit }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lp-section9 {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      --lp9-circle-size: {{ section.settings.circle_size_mobile }}px;
      --lp9-circle-top: {{ section.settings.circle_top_mobile }}%;
      --lp9-circle-left: {{ section.settings.circle_left_mobile }}%;
    }
  }
</style>

<section class="lp-section9" id="lp-section9-{{ section.id }}">
  <div class="lp-section9__bg" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2800
        | image_tag:
          class: 'lp-section9__bg-img lp-section9__bg-img--desktop',
          loading: 'lazy',
          alt: '',
          widths: '750, 1100, 1500, 2000, 2800',
          sizes: '100vw'
      }}
    {% endif %}

    {% if section.settings.background_image_mobile != blank %}
      {{
        section.settings.background_image_mobile
        | image_url: width: 1200
        | image_tag:
          class: 'lp-section9__bg-img lp-section9__bg-img--mobile',
          loading: 'lazy',
          alt: '',
          widths: '375, 550, 750, 1100, 1200',
          sizes: '100vw'
      }}
    {% elsif section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 1200
        | image_tag:
          class: 'lp-section9__bg-img lp-section9__bg-img--mobile',
          loading: 'lazy',
          alt: '',
          widths: '375, 550, 750, 1100, 1200',
          sizes: '100vw'
      }}
    {% endif %}
  </div>

  <div class="lp-section9__inner">
    {% if section.settings.heading_image != blank or section.settings.title != blank %}
      <header class="lp-section9__heading">
        {% if section.settings.heading_image != blank %}
          {{
            section.settings.heading_image
            | image_url: width: 900
            | image_tag: class: 'lp-section9__heading-img', loading: 'lazy', alt: section.settings.title
          }}
        {% elsif section.settings.title != blank %}
          <h2 class="lp-section9__title">{{ section.settings.title }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="lp-section9__row">
      <div class="lp-section9__left">
        {% if section.settings.jeans_image != blank %}
          {{
            section.settings.jeans_image
            | image_url: width: 1200
            | image_tag: class: 'lp-section9__jeans-img', loading: 'lazy', alt: section.settings.title
          }}
        {% endif %}
      </div>

      <div class="lp-section9__right">
        {% if section.settings.show_circle %}
          <div class="lp-section9__circle" aria-hidden="true"></div>
        {% endif %}

        <div class="lp-section9__content">
          {% if section.settings.description != blank %}
            <div class="lp-section9__text">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="lp-section9__btn">
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Page Section 9",
  "tag": "section",
  "class": "section-landing-page-9",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Loom sketch + beige bg. Full section background."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Uses desktop bg if empty."
    },
    {
      "type": "select",
      "id": "bg_fit",
      "label": "Background fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "Heading image",
      "info": "Upload brush heading for exact match (recommended)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading text",
      "default": "BLUE BLOOD 2.0 SLIM STRAIGHT"
    },
    {
      "type": "header",
      "content": "Left - jeans image"
    },
    {
      "type": "image_picker",
      "id": "jeans_image",
      "label": "Jeans image",
      "info": "Jeans with SLIM FIT / MID-RISE arrows baked in"
    },
    {
      "type": "range",
      "id": "left_width",
      "label": "Left column width",
      "min": 35,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 48
    },
    {
      "type": "header",
      "content": "Right - content"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p><strong>The original 5-pocket,</strong> refined over time as denim moved from workwear to everyday essential. The slim straight cut came later—cleaner, sharper, but still rooted in the same rugged DNA.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Red circle"
    },
    {
      "type": "checkbox",
      "id": "show_circle",
      "label": "Show red circle",
      "default": true
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Circle color",
      "default": "#a33b20"
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle size - desktop",
      "min": 200,
      "max": 500,
      "step": 4,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "circle_top",
      "label": "Circle from top - desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "circle_left",
      "label": "Circle from left - desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 38
    },
    {
      "type": "range",
      "id": "circle_size_mobile",
      "label": "Circle size - mobile",
      "min": 160,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "circle_top_mobile",
      "label": "Circle from top - mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "circle_left_mobile",
      "label": "Circle from left - mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background",
      "default": "#e6dfcf"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading accent color",
      "default": "#a33b20"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 960,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Section min height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Margin top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Margin bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margin top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margin bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Landing Page Section 9"
    }
  ]
}
{% endschema %}
