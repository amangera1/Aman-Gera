{{ 'section10-carpenter.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .lp-section10 {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    --lp10-bg: {{ section.settings.background_color }};
    --lp10-accent: {{ section.settings.accent_color }};
    --lp10-max-width: {{ section.settings.max_width }}px;
    --lp10-min-height: {{ section.settings.min_height }}px;
    --lp10-padding-top: {{ section.settings.padding_top }}px;
    --lp10-padding-bottom: {{ section.settings.padding_bottom }}px;
    --lp10-column-gap: {{ section.settings.column_gap }}px;
    --lp10-content-width: {{ section.settings.content_width }}%;
    --lp10-bg-fit: {{ section.settings.bg_fit }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lp-section10 {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    }
  }
</style>

<section class="lp-section10" id="lp-section10-{{ section.id }}">
  <div class="lp-section10__bg" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2800
        | image_tag:
          class: 'lp-section10__bg-img lp-section10__bg-img--desktop',
          loading: 'lazy',
          alt: '',
          widths: '750, 1100, 1500, 2000, 2800',
          sizes: '100vw'
      }}
    {% endif %}

    {% if section.settings.background_image_mobile != blank %}
      {{
        section.settings.background_image_mobile
        | image_url: width: 1200
        | image_tag:
          class: 'lp-section10__bg-img lp-section10__bg-img--mobile',
          loading: 'lazy',
          alt: '',
          widths: '375, 550, 750, 1100, 1200',
          sizes: '100vw'
      }}
    {% elsif section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 1200
        | image_tag:
          class: 'lp-section10__bg-img lp-section10__bg-img--mobile',
          loading: 'lazy',
          alt: '',
          widths: '375, 550, 750, 1100, 1200',
          sizes: '100vw'
      }}
    {% endif %}
  </div>

  <div class="lp-section10__inner">
    {% if section.settings.heading_image != blank or section.settings.title != blank %}
      <header class="lp-section10__heading">
        {% if section.settings.heading_image != blank %}
          {{
            section.settings.heading_image
            | image_url: width: 900
            | image_tag: class: 'lp-section10__heading-img', loading: 'lazy', alt: section.settings.title
          }}
        {% elsif section.settings.title != blank %}
          <h2 class="lp-section10__title">{{ section.settings.title }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="lp-section10__row">
      <div class="lp-section10__content-col">
        {% if section.settings.description != blank %}
          <div class="lp-section10__text">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="lp-section10__btn">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>

      <div class="lp-section10__jeans-col">
        {% if section.settings.jeans_image != blank %}
          {{
            section.settings.jeans_image
            | image_url: width: 1200
            | image_tag: class: 'lp-section10__jeans-img', loading: 'lazy', alt: section.settings.title
          }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Page Section 10",
  "tag": "section",
  "class": "section-landing-page-10",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Motorcycle sketch background"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Uses desktop bg if empty."
    },
    {
      "type": "select",
      "id": "bg_fit",
      "label": "Background fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "Heading image",
      "info": "Upload brush heading for exact match (recommended)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading text",
      "default": "DOUBLE KNEE CARPENTER"
    },
    {
      "type": "header",
      "content": "Left - content"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p><strong>Built for American carpenters</strong> in the early 20th century, this design was all about durability—extra panels, tool pockets, and zero tolerance for wear and tear.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content column width",
      "min": 35,
      "max": 55,
      "step": 1,
      "unit": "%",
      "default": 44
    },
    {
      "type": "header",
      "content": "Right - jeans image"
    },
    {
      "type": "image_picker",
      "id": "jeans_image",
      "label": "Jeans image",
      "info": "Carpenter jeans with DOUBLE KNEE FIT / MID-RISE arrows baked in"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background",
      "default": "#e6dfcf"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading accent color",
      "default": "#a33b20"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 960,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Section min height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Margin top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Margin bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margin top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margin bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Landing Page Section 10"
    }
  ]
}
{% endschema %}
