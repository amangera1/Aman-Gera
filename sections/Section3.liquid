{{ 'section3-true-straight.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .lp-section3 {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    --lp3-bg: {{ section.settings.background_color }};
    --lp3-max-width: {{ section.settings.max_width }}px;
    --lp3-text-top: {{ section.settings.text_top }}%;
    --lp3-text-left: {{ section.settings.text_left }}%;
    --lp3-text-width: {{ section.settings.text_width }}px;
    --lp3-btn-gap: {{ section.settings.button_gap }}px;
    --lp3-text-top-tablet: {{ section.settings.text_top_tablet }}%;
    --lp3-text-left-tablet: {{ section.settings.text_left_tablet }}%;
    --lp3-text-width-tablet: {{ section.settings.text_width_tablet }}px;
    --lp3-text-top-mobile: {{ section.settings.text_top_mobile }}%;
    --lp3-text-left-mobile: {{ section.settings.text_left_mobile }}%;
    --lp3-text-width-mobile: {{ section.settings.text_width_mobile }}px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .lp-section3 {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    }
  }
</style>

<section class="lp-section3" id="lp-section3-{{ section.id }}">
  <div class="lp-section3__frame">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2800
        | image_tag:
          class: 'lp-section3__bg',
          loading: 'lazy',
          alt: 'Blue Blood True Straight',
          widths: '750, 1100, 1500, 2000, 2800',
          sizes: '100vw'
      }}
    {% else %}
      <div
        class="lp-section3__bg"
        style="min-height: 420px; background: var(--lp3-bg, #e5e0d8);"
        role="img"
        aria-label="Blue Blood True Straight"
      ></div>
    {% endif %}

    <div class="lp-section3__overlay">
      <div class="lp-section3__content">
        {% if section.settings.intro_text != blank %}
          <div class="lp-section3__text">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="lp-section3__btn">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Page Section 3",
  "tag": "section",
  "class": "section-landing-page-3",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Upload full design with heading, jeans and graphics. Only overlay text stays editable."
    },
    {
      "type": "header",
      "content": "Dynamic overlay text"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Text",
      "default": "<p><strong>Born in the late 1800s,</strong> the 5-pocket jean was built for miners who needed something tougher than anything else they owned.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "header",
      "content": "Text position - Desktop"
    },
    {
      "type": "range",
      "id": "text_top",
      "label": "Text from top",
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "range",
      "id": "text_left",
      "label": "Text from left",
      "min": 40,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text max width",
      "min": 180,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Gap above button",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text position - Tablet"
    },
    {
      "type": "range",
      "id": "text_top_tablet",
      "label": "Text from top",
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "range",
      "id": "text_left_tablet",
      "label": "Text from left",
      "min": 30,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "text_width_tablet",
      "label": "Text max width",
      "min": 160,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 220
    },
    {
      "type": "header",
      "content": "Text position - Mobile"
    },
    {
      "type": "range",
      "id": "text_top_mobile",
      "label": "Text from top",
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 44
    },
    {
      "type": "range",
      "id": "text_left_mobile",
      "label": "Text center from left",
      "min": 40,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "text_width_mobile",
      "label": "Text max width",
      "min": 180,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 260
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background",
      "default": "#e5e0d8"
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Section margin top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Section margin bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Section margin top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Section margin bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Landing Page Section 3"
    }
  ]
}
{% endschema %}
